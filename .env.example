PORT=3000
NODE_ENV=development
DATA_DIR=./data
TEAM_EMAILS=team@example.com,ops@example.com
TEAM_ALLOWED_EMAILS=you@company.com,teammate@company.com
TEAM_PASSWORD=change-this-shared-password
TEAM_USERS=you@company.com:your-password,teammate@company.com:their-password
SESSION_SECRET=change-this-long-random-secret
FROM_EMAIL=updates@yourdomain.com
UPDATE_REQUEST_FROM_EMAIL=Tyler@Beamanventures.com
UPDATE_REQUEST_REPLY_TO_EMAIL=Tyler@Beamanventures.com
RESEND_API_KEY=re_your_key_here
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Microsoft 365 investment email intake is opt-in and disabled by default.
AI_EMAIL_INTAKE_ENABLED=false
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_MAILBOX_USER=updates@yourdomain.example
MICROSOFT_MAIL_FOLDER_NAME=AI Investment Updates
AI_EMAIL_MAX_MESSAGES_PER_RUN=10
AI_EMAIL_ALLOWED_SENDERS=founder@portfolio.example,finance@portfolio.example
AI_EMAIL_ALLOWED_DOMAINS=portfolio.example,advisor.example
